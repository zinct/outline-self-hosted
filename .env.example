# =============================================================================
# Outline Self-Hosted Configuration
# Copy to .env: cp .env.example .env
# Or run: ./setup.sh
# =============================================================================

NODE_ENV=production

# Public URL for Outline (required). Local dev: http://localhost:3000
URL=http://localhost:3000
PORT=3000
OUTLINE_PORT=3000

# Generate with: openssl rand -hex 32
SECRET_KEY=generate_with_openssl_rand_hex_32
UTILS_SECRET=generate_with_openssl_rand_hex_32

# Database
POSTGRES_USER=outline
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=outline
DATABASE_URL=postgres://outline:change_me_strong_password@postgres:5432/outline
DATABASE_CONNECTION_POOL_MIN=1
DATABASE_CONNECTION_POOL_MAX=5
PGSSLMODE=disable

# Redis
REDIS_URL=redis://redis:6379

# Local file storage
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# SSL (set true when behind an HTTPS reverse proxy)
FORCE_HTTPS=false

DEFAULT_LANGUAGE=en_US
LOG_LEVEL=info
ENABLE_UPDATES=true

# =============================================================================
# Pocket ID — lightweight OIDC provider (~33MB, SQLite, no extra DB)
# Docs: https://pocket-id.org/docs/client-examples/outline
# =============================================================================

POCKETID_PORT=1411
# Public URL — MUST match the exact subdomain you open in the browser (HTTPS in production, no trailing slash)
POCKETID_APP_URL=http://localhost:1411
POCKETID_INTERNAL_APP_URL=http://pocket-id:1411
# Set to true when behind Nginx/Traefik/Cloudflare (required for passkeys on VPS)
POCKETID_TRUST_PROXY=false
POCKETID_ALLOW_INSECURE_CALLBACK_URLS=true
# Generate with: openssl rand -base64 32
# IMPORTANT: Do not change after first run — will corrupt Pocket ID data
POCKETID_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32

# Fill in after creating an OIDC client in Pocket ID admin (see README)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_URI=http://localhost:1411/authorize
OIDC_TOKEN_URI=http://pocket-id:1411/api/oidc/token
OIDC_USERINFO_URI=http://pocket-id:1411/api/oidc/userinfo
OIDC_LOGOUT_URI=http://localhost:1411/api/oidc/end-session
OIDC_DISPLAY_NAME=Pocket ID
OIDC_USERNAME_CLAIM=preferred_username
OIDC_SCOPES=openid profile email groups

# =============================================================================
# Alternative auth providers (optional, replace Pocket ID if needed)
# =============================================================================

# --- Generic OIDC (Authentik, Keycloak, etc.) ---
# OIDC_ISSUER_URL=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# --- Google ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Slack ---
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# =============================================================================
# Email (optional, for notifications)
# =============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@example.com
